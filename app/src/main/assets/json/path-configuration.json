{
  "settings": {},
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "fallback_uri": "hotwire://fragment/sign-in",
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "/sign_in$"
      ],
      "properties": {
        "title": "Sign in",
        "uri": "hotwire://fragment/sign-in"
      }
    },
    {
      "patterns": [
        "/settings$"
      ],
      "properties": {
        "title": "My Settings",
        "uri": "hotwire://fragment/settings"
      }
    }
  ]
}
