{
  "settings": {},
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "fallback_uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": true 
      }
    },
    {
      "patterns": [
        "/sign_in$"
      ],
      "properties": {
        "title": "Sign in",
        "uri": "hotwire://fragment/sign-in",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "/settings$"
      ],
      "properties": {
        "title": "My Settings",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": true 
      }
    },
    {
      "patterns": [
        "/status$"
      ],
      "properties": {
        "title": "My Settings",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": true
      }
    }
  ]
}
