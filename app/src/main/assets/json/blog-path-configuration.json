{
  "settings": {},
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "fallback_uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": true 
      }
    },
    {
      "patterns": [
        "/posts$"
      ],
      "properties": {
        "title": "Posts",
        "uri": "hotwire://fragment/posts",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "/posts/new$"
      ],
      "properties": {
        "title": "New Post",
        "uri": "hotwire://fragment/new-post",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "/comments$"
      ],
      "properties": {
        "title": "Comments",
        "uri": "hotwire://fragment/comments",
        "pull_to_refresh_enabled": true
      }
    }
  ]
}
