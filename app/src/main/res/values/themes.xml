<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- Base application theme. -->
  <style name="Base.Theme.Scribble" parent="Theme.Material3.DayNight.NoActionBar">
    <!-- Customize your light theme here. -->
    <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    <item name="colorPrimary">#0172AD</item>
    <item name="colorOnPrimary">@android:color/black</item>
    <item name="materialButtonStyle">@style/CustomMaterialButton</item>
  </style>

  <!-- Custom button style that inherits Material 3 defaults -->
  <style name="CustomMaterialButton" parent="Widget.Material3.Button">
    <item name="backgroundTint">#0172AD</item>
    <item name="android:textColor">@android:color/white</item>
    <item name="cornerRadius">6dp</item>
  </style>
  <style name="Theme.Scribble" parent="Base.Theme.Scribble" />
</resources>